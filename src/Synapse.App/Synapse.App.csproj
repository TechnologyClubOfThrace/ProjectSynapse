<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Version>2.0.0</Version>
    <ApplicationIcon />
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\tree-botanical-v1.png"
                      LogicalName="Synapse.App.Assets.TreeBotanical.png" />
    <EmbeddedResource Include="Assets\synapse-logo-gr.png"
                      LogicalName="Synapse.App.Assets.SynapseLogoGr.png" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.33" />
    <ProjectReference Include="..\Synapse.Audio\Synapse.Audio.csproj" />
    <ProjectReference Include="..\Synapse.Input\Synapse.Input.csproj" />
  </ItemGroup>
</Project>

